# Reference only. Never replace your real .env with this file blindly.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Omit DATABASE_URL locally to retain the stable backend SQLite file.
# Render/Supabase: copy YOUR Session pooler host/user from Supabase Connect.
# Exact driver: psycopg 3, installed by psycopg[binary] in requirements.txt.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@EXACT_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Do not use port 6543, an anon key, service_role API key, or Supabase Auth here.
# Set APP_ENV=production and the exact Vercel production origin on Render.
# CORS_ORIGINS=https://YOUR_APP.vercel.app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# On separate Vercel/Render origins use COOKIE_SECURE=true, COOKIE_SAMESITE=none.
# Browser third-party-cookie restrictions can still require a same-origin proxy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional older hosted-schema upgrade only, AFTER a real snapshot/export:
# POSTGRES_BACKUP_CONFIRMED=true
# Optional live tests ONLY with a DIFFERENT disposable project/database:
# SMARTSPEND_TEST_POSTGRES_URL=postgresql+psycopg://...:5432/postgres?sslmode=require
# SMARTSPEND_TEST_POSTGRES_CONFIRM=disposable-smartspend-database
